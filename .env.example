# Local demonstration only. No real financial services or outbound email.
DATABASE_URL=postgresql://exw:exw_local_only@127.0.0.1:54329/exw
STORE_DATABASE_URL=postgresql://exw_store:exw_store_local_only@127.0.0.1:54329/exw_store
API_PORT=4000
PORTAL_PORT=3000
STORE_PORT=3001
# Public origins. API_URL may be the Portal origin plus /api (Next forwards /api/* to the API service), which keeps cookies first-party on hosts such as trycloudflare.com or onrender.com.
API_URL=http://localhost:4000
PORTAL_URL=http://localhost:3000
STORE_URL=http://localhost:3001
# Server-to-server address of the API used by the Playground and the sample store (default: the local listener).
# API_INTERNAL_URL=http://127.0.0.1:4000
# Alternative for hosts that expose host:port of the API service (Render Blueprint fromService hostport):
# API_INTERNAL_HOSTPORT=exw-api:10000
# Single PostgreSQL instance: instead of STORE_DATABASE_URL, give STORE_DB_HOST (+ STORE_DB_PORT, default 5432) and STORE_DB_PASSWORD;
# the API runs packages/database/src/bootstrap-store.ts at start to create role/database exw_store (STORE_DB_ROLE / STORE_DB_NAME) and revoke its access to the ledger.
# STORE_DB_HOST=
# STORE_DB_PASSWORD=
# Bind address. Keep loopback on a PC; containers must bind 0.0.0.0. Container hosts may also inject PORT per service.
# LISTEN_HOST=127.0.0.1
# lax (default) when Portal, API and store share one site or use the /api proxy; none only for HTTPS split-site deployments (Safari still blocks third-party cookies).
# COOKIE_SAMESITE=lax
# true runs the worker loop inside the API process (for hosts whose free tier has no background workers). Default: separate worker process.
# WORKER_IN_API=false
# Built-in sign-in shown on the welcome screen for the sample consumer. It only opens the visitor's own isolated
# workspace, the same one the start button creates. Set an empty DEMO_LOGIN_PASSWORD to remove the sign-in.
# DEMO_LOGIN_ID=kuro
# DEMO_LOGIN_PASSWORD=0130
DEMO_MODE=local
SINGLE_WORKSPACE=false
# Generate with `pnpm db:seed`; .local/keys.json is ignored by Git.
# Set a random 32-byte hex value in deployed environments.
ENCRYPTION_KEY=
# Exact URLs, comma separated. Public demo must use administrator-owned HTTPS URLs.
WEBHOOK_ALLOWLIST=http://localhost:3001/webhooks/express-wallet
SETTLEMENT_DELAY_SECONDS=60
# E2E default: msedge on Windows; managed Chromium on Linux/macOS.
# Optional override: chromium / msedge / chrome.
# PLAYWRIGHT_CHANNEL=chromium
